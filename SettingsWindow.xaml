<Window x:Class="GridSurf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GridSurf — Settings"
        Height="480" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="UrlPanel" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">Visible panes</TextBlock>
            <TextBox x:Name="ViewCountBox" Width="50" VerticalContentAlignment="Center" Padding="6,4" />
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11">(1–8)</TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,10,0,0">
            Each pane has an independent session (cookies, login). Unused panes are suspended to save RAM.
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="88" Margin="6,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="88" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
